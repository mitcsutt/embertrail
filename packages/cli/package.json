{
  "name": "@mitcsutt/embertrail-cli",
  "version": "0.0.0",
  "description": "The embertrail command-line tool",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitcsutt/embertrail.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/mitcsutt/embertrail/issues",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@mitcsutt/kiln-tsconfig": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "embertrail": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@mitcsutt/embertrail-client": "workspace:*",
    "@mitcsutt/embertrail-hub": "workspace:*",
    "@mitcsutt/embertrail-otel": "workspace:*",
    "@mitcsutt/embertrail-server": "workspace:*",
    "@mitcsutt/embertrail-store": "workspace:*"
  }
}
