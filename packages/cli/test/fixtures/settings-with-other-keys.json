{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": ["Bash(git status:*)"],
    "deny": ["Read(./.env)"]
  },
  "hooks": {
    "PostToolUse": [
      { "matcher": "Edit", "hooks": [{ "type": "command", "command": "prettier --write" }] }
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "OTEL_TRACES_EXPORTER": "none"
  }
}
