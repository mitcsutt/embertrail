{
  "extends": "@mitcsutt/kiln-tsconfig/library",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    "declarationMap": false,
    "sourceMap": false,
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
