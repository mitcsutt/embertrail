{
  "name": "@mitcsutt/embertrail-client",
  "version": "0.0.0",
  "description": "Typed client for the Embertrail Query API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitcsutt/embertrail.git",
    "directory": "packages/client"
  },
  "bugs": "https://github.com/mitcsutt/embertrail/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "node scripts/generate.ts",
    "lint": "eslint --max-warnings=0 .",
    "lint:package": "node scripts/check-package.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@mitcsutt/embertrail-hub": "workspace:*",
    "@mitcsutt/embertrail-modules": "workspace:*",
    "@mitcsutt/kiln-tsconfig": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "openapi-typescript": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
