{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "filters": {
      "type": "object",
      "properties": {
        "time": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "relative"
                },
                "range": {
                  "type": "string",
                  "enum": [
                    "today",
                    "yesterday",
                    "this-week",
                    "last-7-days",
                    "last-30-days",
                    "last-90-days"
                  ]
                }
              },
              "required": ["kind", "range"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "absolute"
                },
                "from": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "required": ["kind", "from", "to"],
              "additionalProperties": false
            }
          ]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": ["time"],
      "additionalProperties": false
    },
    "items": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "i": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "type": {
                "type": "string",
                "const": "widget"
              },
              "widget": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "override": {
                "type": "object",
                "properties": {
                  "time": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "relative"
                          },
                          "range": {
                            "type": "string",
                            "enum": [
                              "today",
                              "yesterday",
                              "this-week",
                              "last-7-days",
                              "last-30-days",
                              "last-90-days"
                            ]
                          }
                        },
                        "required": ["kind", "range"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "absolute"
                          },
                          "from": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          },
                          "to": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          }
                        },
                        "required": ["kind", "from", "to"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "sourceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "accountId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "additionalProperties": false
              }
            },
            "required": ["i", "type", "widget"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "i": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "type": {
                "type": "string",
                "const": "query"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "query": {
                "type": "object",
                "properties": {
                  "source": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "metric"
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "aggregation": {
                            "type": "string",
                            "enum": ["sum", "avg", "min", "max", "count", "last"]
                          }
                        },
                        "required": ["kind", "name", "aggregation"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "event"
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "aggregation": {
                            "type": "object",
                            "properties": {
                              "fn": {
                                "type": "string",
                                "minLength": 1
                              },
                              "key": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": ["fn"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["kind", "name", "aggregation"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "groupBy": {
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "bucket": {
                    "type": "string",
                    "enum": ["minute", "hour", "day", "week", "month"]
                  },
                  "filter": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "key": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            "op": {
                              "type": "string",
                              "enum": ["eq", "neq", "gt", "gte", "lt", "lte"]
                            },
                            "value": {
                              "type": ["string", "number", "boolean"]
                            }
                          },
                          "required": ["key", "op", "value"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "key": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            "op": {
                              "type": "string",
                              "enum": ["in", "not_in"]
                            },
                            "value": {
                              "minItems": 1,
                              "maxItems": 100,
                              "type": "array",
                              "items": {
                                "type": ["string", "number", "boolean"]
                              }
                            }
                          },
                          "required": ["key", "op", "value"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "key": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            "op": {
                              "type": "string",
                              "enum": ["exists", "not_exists"]
                            }
                          },
                          "required": ["key", "op"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "chart": {
                    "type": "string",
                    "enum": ["stat", "series", "bars", "bar-list", "share", "table", "heatmap"]
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["source", "groupBy", "filter", "chart"],
                "additionalProperties": false
              },
              "override": {
                "type": "object",
                "properties": {
                  "time": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "relative"
                          },
                          "range": {
                            "type": "string",
                            "enum": [
                              "today",
                              "yesterday",
                              "this-week",
                              "last-7-days",
                              "last-30-days",
                              "last-90-days"
                            ]
                          }
                        },
                        "required": ["kind", "range"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "absolute"
                          },
                          "from": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          },
                          "to": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          }
                        },
                        "required": ["kind", "from", "to"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "sourceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "accountId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "additionalProperties": false
              }
            },
            "required": ["i", "type", "title", "query"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "i": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "type": {
                "type": "string",
                "const": "section"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": ["i", "type", "title"],
            "additionalProperties": false
          }
        ]
      }
    },
    "layout": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "i": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "w": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "h": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "static": {
            "type": "boolean"
          }
        },
        "required": ["i", "x", "y", "w", "h"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "name", "filters", "items", "layout"],
  "additionalProperties": false
}
